# Copy this file to `.env` for local development. Never commit the real `.env`.

NODE_ENV=development

# Backend API
API_PORT=3000

# PostgreSQL (provisioned by docker-compose for local development)
POSTGRES_USER=agencyhub
POSTGRES_PASSWORD=agencyhub
POSTGRES_DB=agencyhub
POSTGRES_PORT=5432

# The application connects as a least-privilege role that is neither a superuser nor
# the owner of the tables — PostgreSQL bypasses Row-Level Security for both, which
# would make the tenant-isolation policies silently inert. `npm run db:provision`
# creates this role from the credentials in DATABASE_URL; migrations use DB_OWNER_*.
DB_OWNER_USER=agencyhub
DB_OWNER_PASSWORD=agencyhub

# `connection_limit` is sized for concurrent *requests*, not concurrent queries:
# the RLS pattern in docs/sdd/14-database-design.md holds one connection for a
# request's full duration. See docs/decisions/0011-infrastructure-sizing.md.
DATABASE_URL=postgresql://agency_hub_app:change-me-locally@localhost:5432/agencyhub?connection_limit=10

# Same database, reached from inside the Docker Compose network (service name
# `postgres` instead of `localhost`). Only used by docker-compose.yml.
DATABASE_URL_DOCKER=postgresql://agency_hub_app:change-me-locally@postgres:5432/agencyhub?connection_limit=10

# Integration test database. The test setup DROPS and recreates this database on
# every run — never point it at a database holding real data.
TEST_DATABASE_URL=postgresql://agency_hub_app:change-me-locally@localhost:5432/agencyhub_test?connection_limit=5

# Frontend dev server
WEB_PORT=5173
VITE_API_URL=http://localhost:3000

# ── Authentication (docs/sdd/10-authentication-and-sessions.md) ──────────────
# Server-side pepper mixed into every Argon2id hash. Generate with
# `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`.
# Rotating it invalidates every existing password — treat it as permanent for the
# life of the database.
PASSWORD_PEPPER=replace-me-with-a-long-random-value
SESSION_COOKIE_NAME=agency_hub_session
# Must be true in production (HTTPS only); false locally so the cookie works over http.
SESSION_COOKIE_SECURE=false
SESSION_SLIDING_DAYS=7
SESSION_ABSOLUTE_DAYS=30
REAUTH_WINDOW_MINUTES=15
CORS_ORIGIN=http://localhost:5173

# First administrator, created by `npm run db:seed --workspace=@agency-hub/api`.
# Leave BOOTSTRAP_ADMIN_PASSWORD empty to have one generated and printed once.
BOOTSTRAP_ADMIN_NAME=Administrador
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=

# ── Object storage (docs/sdd/07-upload-architecture.md) ─────────────────────
# The application speaks the S3 API to whatever is behind STORAGE_*: MinIO from
# docker-compose during development and tests, Cloudflare R2 in production. Nothing
# in the code branches on which one it is.
#
# For production, point these at the R2 values below:
#   STORAGE_ENDPOINT=$R2_ENDPOINT
#   STORAGE_ACCESS_KEY_ID=$R2_ACCESS_KEY_ID
#   STORAGE_SECRET_ACCESS_KEY=$R2_SECRET_ACCESS_KEY
#   STORAGE_BUCKET=$R2_BUCKET
#   STORAGE_FORCE_PATH_STYLE=false
#   STORAGE_PUBLIC_ORIGIN=$R2_ENDPOINT
# STORAGE_PUBLIC_ORIGIN is the origin the browser sends file parts to. The production
# Content-Security-Policy (deploy/Caddyfile) allows exactly that origin and no other, so
# the production compose file refuses to start without it. Not used in development.
STORAGE_ENDPOINT=http://localhost:9000
# Reachable from inside the Docker network; only docker-compose.yml uses this.
STORAGE_ENDPOINT_DOCKER=http://minio:9000
STORAGE_ACCESS_KEY_ID=agencyhub
STORAGE_SECRET_ACCESS_KEY=agencyhub-dev-secret
STORAGE_BUCKET=agency-hub-dev
STORAGE_REGION=auto
# MinIO needs path-style addressing; R2 does not.
STORAGE_FORCE_PATH_STYLE=true
STORAGE_PORT=9000
STORAGE_CONSOLE_PORT=9001

# Buckets used by the automated suites. The tooling refuses to run against any
# endpoint on r2.cloudflarestorage.com, so a test can never reach production storage.
TEST_STORAGE_BUCKET=agency-hub-test
E2E_STORAGE_BUCKET=agency-hub-e2e

# Upload policy. Every one of these is an initial configuration value, tunable
# without a code change (docs/sdd/07-upload-architecture.md).
UPLOAD_MAX_FILE_BYTES=32212254720
UPLOAD_PART_SIZE_BYTES=16777216
UPLOAD_PRESIGN_BATCH_SIZE=10
UPLOAD_PRESIGN_TTL_SECONDS=1200
UPLOAD_SESSION_TTL_HOURS=24
UPLOAD_MAX_ACTIVE_SESSIONS_PER_COMPANY=5
UPLOAD_DOWNLOAD_TTL_SECONDS=300
# Hourly. The bucket also carries a 7-day lifecycle rule as an independent net.
UPLOAD_CLEANUP_CRON=0 * * * *
WORKER_DATABASE_POOL_SIZE=5
# Sweeps for content that passed its date without being finished.
CONTENT_OVERDUE_CRON=15 * * * *

# ── Web Push (docs/decisions/0005-push-notifications.md) ────────────────────
# Generate a pair with:  npm run push:keys --workspace=@agency-hub/api
# Leave these empty and the app runs with in-app notifications only, which are the
# system of record either way — push is a best-effort accelerant on top of them.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:voce@suaagencia.com.br
# Tunable without a code change (docs/sdd/08-notifications-and-push.md).
PUSH_RESOURCE_WINDOW_SECONDS=300
PUSH_MAX_PER_USER_PER_HOUR=20

# ── Manual database backup (docs/sdd/11-backup-and-recovery.md) ─────────────
# Shared between the API container and the worker; in Docker this is a named volume.
BACKUP_DIRECTORY=./var/backups
# The dump is deleted this long after it finishes, downloaded or not.
BACKUP_RETENTION_MINUTES=120
BACKUP_CLEANUP_CRON=30 * * * *
# 64 hex characters. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Leave empty to store the dump compressed but unencrypted.
BACKUP_ENCRYPTION_KEY=

# ── Cloudflare R2 (docs/sdd/07-upload-architecture.md) ──────────────────────
# From the Cloudflare dashboard: R2 → Manage API tokens → "S3 clients" credentials.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=agency-hub
# Only needed for bucket administration (CORS rules), not for uploads themselves.
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

# ── VPS / deploy (docs/sdd/19-deployment-and-cicd.md, Stage 15) ─────────────
# Used by the deploy tooling, never by the application at runtime. In CI these
# come from GitHub Secrets, not from this file.
VPS_HOST=your.vps.ip.address
VPS_USER=deploy
VPS_ROOT_PASSWORD=
VPS_SSH_PUBLIC_KEY=""

# ── End-to-end tests (Playwright) ───────────────────────────────────────────
# Dropped and recreated on every E2E run; the tooling refuses any database name
# without "_e2e" in it.
E2E_DATABASE_URL=postgresql://agency_hub_app:change-me-locally@localhost:5432/agencyhub_e2e
E2E_API_PORT=3101
E2E_WEB_PORT=5273
