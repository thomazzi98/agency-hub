# Copy this file to `.env` for local development. Never commit the real `.env`.

NODE_ENV=development

# Backend API
API_PORT=3000

# PostgreSQL (provisioned by docker-compose for local dev; the API does not
# connect to it yet — wired up starting in Stage 1 of docs/sdd/21-mvp-roadmap.md)
POSTGRES_USER=agencyhub
POSTGRES_PASSWORD=agencyhub
POSTGRES_DB=agencyhub
POSTGRES_PORT=5432
DATABASE_URL=postgresql://agencyhub:agencyhub@localhost:5432/agencyhub

# Frontend dev server
WEB_PORT=5173
VITE_API_URL=http://localhost:3000
