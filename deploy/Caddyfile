# Production reverse proxy and static host (docs/sdd/19-deployment-and-cicd.md).
#
# One container serves the built frontend and proxies /api to the API service, which
# keeps the session cookie same-origin exactly as the Vite dev proxy does locally —
# so nothing in the application branches on which environment it is in.
#
# APP_DOMAIN is supplied by docker-compose.prod.yml. Caddy obtains and renews the
# certificate itself; there is no certificate cron to forget.

# Anything that reaches port 80 under a name that is not the site - typically the bare
# IP address typed into a browser - is sent to the site. No certificate can ever be
# issued for an IP, so the IP itself is never served, only redirected.
http:// {
	redir https://{$APP_DOMAIN}{uri} permanent
}

{$APP_DOMAIN} {
	encode zstd gzip

	# Sent on every response, including the static ones (16-security-requirements.md).
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# The app loads nothing from a third party; uploads go straight to storage,
		# which is why connect-src has to allow it.
		Content-Security-Policy "default-src 'self'; img-src 'self' data: blob: {$STORAGE_PUBLIC_ORIGIN}; connect-src 'self' {$STORAGE_PUBLIC_ORIGIN}; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'"
		-Server
	}

	handle /api/* {
		reverse_proxy api:3000 {
			# A 30 GB upload is signed here and sent straight to storage, so nothing
			# large flows through this proxy — but a slow client still must not be cut
			# off mid-request (07-upload-architecture.md).
			transport http {
				read_timeout 300s
				write_timeout 300s
			}
		}
	}

	handle /health/* {
		reverse_proxy api:3000
	}

	# The service worker must never be served stale: it is what decides whether a push
	# notification arrives at all (08-notifications-and-push.md).
	@serviceworker path /sw.js
	header @serviceworker Cache-Control "no-cache"

	# Vite fingerprints everything under /assets, so those can be cached hard.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	handle {
		root * /srv
		# A single-page app: unknown paths are routes, not missing files.
		try_files {path} /index.html
		# The shell names the hashed bundles each deploy replaces. Sent with no caching
		# rule at all, browsers cached it heuristically - for hours after a deploy they
		# kept loading the previous release. It is revalidated instead, which with its
		# ETag costs a 304 and nothing more.
		@shell not path /assets/*
		header @shell Cache-Control "no-cache"
		file_server
	}
}

# Other projects on this host. This Caddy is the one process that can hold ports 80
# and 443, so each of them drops a single site file here: a block for its own
# hostname that proxies to its container over the external `edge` network. They get
# the same automatic certificates, and an empty directory imports nothing.
import /etc/caddy/sites/*.caddy
