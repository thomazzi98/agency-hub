// Schema for docs/sdd/14-database-design.md. Tables are added per roadmap
// stage rather than all up front (docs/sdd/21-mvp-roadmap.md, Stage 1).
//
// Conventions:
//   - snake_case in the database, camelCase in the Prisma client (15-api-conventions.md).
//   - UUID primary keys generated by Postgres (`gen_random_uuid()`), so rows created
//     by raw SQL and by Prisma are indistinguishable.
//   - `timestamptz(6)` everywhere: the product spans timezones only incidentally today,
//     but a naive timestamp is unrecoverable once written.
//   - onDelete: Restrict by default — this product soft-deletes and archives; an
//     accidental cascade is exactly the data loss 16-security-requirements.md forbids.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  agency_admin
  agency_manager
  client_manager
  contributor

  @@map("user_role")
}

enum UserStatus {
  active
  inactive

  @@map("user_status")
}

enum CompanyStatus {
  active
  archived

  @@map("company_status")
}

enum MembershipStatus {
  active
  revoked

  @@map("membership_status")
}

/// Global identity. Access to any company comes exclusively through
/// CompanyMembership — never from a column on this table.
model User {
  id                  String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String     @db.VarChar(160)
  /// Stored already lower-cased and trimmed by the application, so this unique
  /// index is effectively case-insensitive without a functional index.
  email               String     @unique @db.VarChar(254)
  passwordHash        String     @map("password_hash") @db.Text
  role                UserRole
  status              UserStatus @default(active)
  mustChangePassword  Boolean    @default(true) @map("must_change_password")
  lastLoginAt         DateTime?  @map("last_login_at") @db.Timestamptz(6)
  /// Consecutive failures only; reset to zero on any successful login.
  failedLoginAttempts Int        @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?  @map("locked_until") @db.Timestamptz(6)
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships             CompanyMembership[]  @relation("MembershipUser")
  createdCompanies        Company[]            @relation("CompanyCreatedBy")
  createdMemberships      CompanyMembership[]  @relation("MembershipCreatedBy")
  sessions                Session[]
  auditLogs               AuditLog[]
  passwordResetAudits     PasswordResetAudit[] @relation("PasswordResetTarget")
  performedPasswordResets PasswordResetAudit[] @relation("PasswordResetPerformer")
  brandingUpdates         BrandingSettings[]   @relation("BrandingUpdatedBy")
  createdProjects         Project[]            @relation("ProjectCreatedBy")
  createdFolders          Folder[]             @relation("FolderCreatedBy")
  uploadedFiles           File[]               @relation("FileUploadedBy")
  uploadSessions          UploadSession[]      @relation("UploadInitiatedBy")
  deletionRequests        DeletionRequest[]    @relation("DeletionRequestedBy")
  reviewedDeletions       DeletionRequest[]    @relation("DeletionReviewedBy")
  comments                Comment[]            @relation("CommentAuthor")
  responsibleContent      Content[]            @relation("ContentResponsible")
  createdContent          Content[]            @relation("ContentCreatedBy")
  createdTopics           Topic[]              @relation("TopicCreator")
  responsibleTopics       Topic[]              @relation("TopicResponsible")
  topicReplies            TopicReply[]         @relation("TopicReplyAuthor")
  responsiblePublications Publication[]        @relation("PublicationResponsible")
  responsibleRequests     PendingRequest[]     @relation("PendingRequestResponsible")
  createdRequests         PendingRequest[]     @relation("PendingRequestCreatedBy")
  notifications           Notification[]       @relation("NotificationRecipient")
  triggeredNotifications  Notification[]       @relation("NotificationActor")
  notificationPreferences NotificationPreference[]
  pushDevices             PushDevice[]
  createdAdAccounts       AdAccount[]          @relation("AdAccountCreatedBy")
  responsibleCampaigns    Campaign[]           @relation("CampaignResponsible")
  createdCampaigns        Campaign[]           @relation("CampaignCreatedBy")
  campaignChanges         CampaignHistory[]    @relation("CampaignHistoryChangedBy")
  backupJobs              BackupJob[]          @relation("BackupRequestedBy")

  @@index([status])
  @@map("users")
}

/// The tenant. Every tenant-owned table carries company_id (directly or via a parent).
model Company {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String        @db.VarChar(160)
  logoUrl         String?       @map("logo_url") @db.Text
  segment         String?       @db.VarChar(120)
  responsibleName String?       @map("responsible_name") @db.VarChar(160)
  email           String?       @db.VarChar(254)
  phone           String?       @db.VarChar(40)
  status          CompanyStatus @default(active)
  notes           String?       @db.Text
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById     String?       @map("created_by") @db.Uuid

  createdBy        User?               @relation("CompanyCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  memberships      CompanyMembership[]
  auditLogs        AuditLog[]
  projects         Project[]
  folders          Folder[]
  files            File[]
  uploadSessions   UploadSession[]
  deletionRequests DeletionRequest[]
  comments         Comment[]
  topics           Topic[]
  content          Content[]
  pendingRequests  PendingRequest[]
  notifications    Notification[]
  adAccounts       AdAccount[]
  campaigns        Campaign[]

  @@index([status])
  @@index([createdById])
  @@index([createdAt(sort: Desc)])
  @@map("companies")
}

/// The access-granting join table: without an active row here, a non-agency_admin
/// user has no access to a company at all (06-permissions-and-authorization.md).
model CompanyMembership {
  id                    String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String           @map("user_id") @db.Uuid
  companyId             String           @map("company_id") @db.Uuid
  status                MembershipStatus @default(active)
  canManageCampaigns    Boolean          @default(false) @map("can_manage_campaigns")
  canDeleteCompanyFiles Boolean          @default(false) @map("can_delete_company_files")
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById           String?          @map("created_by") @db.Uuid

  user      User    @relation("MembershipUser", fields: [userId], references: [id], onDelete: Restrict)
  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdBy User?   @relation("MembershipCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([userId, companyId])
  @@index([companyId, status])
  @@index([userId, status])
  @@index([createdById])
  @@map("company_memberships")
}

enum ProjectType {
  property
  product
  service
  event
  campaign
  internal
  other

  @@map("project_type")
}

enum ProjectStatus {
  planned
  active
  paused
  completed
  archived

  @@map("project_status")
}

enum FileStatus {
  received
  in_review
  editing
  edit_complete
  approved
  archived

  @@map("file_status")
}

enum UploadSessionStatus {
  pending
  in_progress
  completed
  aborted
  expired

  @@map("upload_session_status")
}

enum DeletionRequestTargetType {
  file
  content

  @@map("deletion_request_target_type")
}

enum DeletionRequestStatus {
  pending
  approved
  rejected

  @@map("deletion_request_status")
}

enum Priority {
  low
  medium
  high

  @@map("priority")
}

enum CommentableType {
  company
  project
  file
  content
  pending_request

  @@map("commentable_type")
}

enum TopicRelatedType {
  project
  content
  campaign
  pending_request
  file

  @@map("topic_related_type")
}

enum TopicStatus {
  open
  awaiting_response
  in_review
  resolved
  cancelled

  @@map("topic_status")
}

enum ContentType {
  video
  image
  carousel
  story
  reels
  youtube_short
  text
  custom

  @@map("content_type")
}

enum ProductionStatus {
  planned
  awaiting_material
  in_production
  in_review
  approved
  completed
  cancelled

  @@map("production_status")
}

enum BackupJobStatus {
  queued
  processing
  completed
  failed

  @@map("backup_job_status")
}

enum AdPlatform {
  meta
  tiktok

  @@map("ad_platform")
}

enum AdAccountStatus {
  active
  paused
  closed

  @@map("ad_account_status")
}

enum CampaignStatus {
  active
  paused
  ended
  with_problem
  awaiting_approval
  needs_attention

  @@map("campaign_status")
}

enum NotificationChannel {
  in_app
  push

  @@map("notification_channel")
}

enum PendingRequestStatus {
  open
  awaiting_client
  answered
  in_review
  completed
  cancelled

  @@map("pending_request_status")
}

enum PublicationNetwork {
  instagram
  facebook
  tiktok
  youtube_shorts

  @@map("publication_network")
}

enum PublicationStatus {
  not_planned
  planned
  scheduled
  published
  not_published
  failed
  cancelled

  @@map("publication_status")
}

enum PasswordResetAction {
  temp_password_generated
  password_reset

  @@map("password_reset_action")
}

/// One row per active login. Server-side because the spec requires individually
/// revocable sessions, which a stateless token cannot provide (ADR-0006).
model Session {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  /// SHA-256 of the opaque token. The token itself is high-entropy random, so a
  /// fast hash is sufficient here — unlike a password, it is not guessable.
  sessionTokenHash   String    @unique @map("session_token_hash") @db.Char(64)
  ipAddress          String?   @map("ip_address") @db.VarChar(45)
  userAgent          String?   @map("user_agent") @db.VarChar(512)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastActiveAt       DateTime  @default(now()) @map("last_active_at") @db.Timestamptz(6)
  /// Sliding expiry, pushed forward by activity.
  expiresAt          DateTime  @map("expires_at") @db.Timestamptz(6)
  /// Hard cap since the original login; activity never extends this.
  absoluteExpiresAt  DateTime  @map("absolute_expires_at") @db.Timestamptz(6)
  /// Last time the password was proven on this session; gates step-up
  /// reauthentication for sensitive operations (ADR-0010).
  passwordVerifiedAt DateTime  @map("password_verified_at") @db.Timestamptz(6)
  revokedAt          DateTime? @map("revoked_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

/// Separate from audit_logs because the spec requires a dedicated, narrower trail
/// for password actions (10-authentication-and-sessions.md).
model PasswordResetAudit {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  targetUserId  String              @map("target_user_id") @db.Uuid
  performedById String?             @map("performed_by") @db.Uuid
  action        PasswordResetAction
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  targetUser  User  @relation("PasswordResetTarget", fields: [targetUserId], references: [id], onDelete: Restrict)
  performedBy User? @relation("PasswordResetPerformer", fields: [performedById], references: [id], onDelete: Restrict)

  @@index([targetUserId, createdAt(sort: Desc)])
  @@index([performedById])
  @@map("password_reset_audits")
}

/// Append-only security trail (16-security-requirements.md#audited-actions).
model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  companyId  String?  @map("company_id") @db.Uuid
  action     String   @db.VarChar(80)
  entityType String?  @map("entity_type") @db.VarChar(60)
  entityId   String?  @map("entity_id") @db.Uuid
  metadata   Json?    @db.JsonB
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor   User?    @relation(fields: [actorId], references: [id], onDelete: Restrict)
  company Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId, createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@map("audit_logs")
}

/// Backs the per-IP login rate limit. Deliberately not derived from audit_logs:
/// an audit retention policy must never be able to weaken a security control.
model LoginAttempt {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email      String   @db.VarChar(254)
  ipAddress  String   @map("ip_address") @db.VarChar(45)
  successful Boolean
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([ipAddress, createdAt(sort: Desc)])
  @@index([createdAt])
  @@map("login_attempts")
}

/// Single global row in Phase 1 — per-company (white-label) branding is explicitly
/// postponed (14-database-design.md#platform-tables). The one-row invariant is a
/// unique index on a constant expression, added in the migration: a convention that
/// only application code respects is one careless insert away from two brands.
model BrandingSettings {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  appName        String   @map("app_name") @db.VarChar(60)
  primaryColor   String   @map("primary_color") @db.Char(7)
  secondaryColor String   @map("secondary_color") @db.Char(7)
  logoUrl        String?  @map("logo_url") @db.Text
  faviconUrl     String?  @map("favicon_url") @db.Text
  loginImageUrl  String?  @map("login_image_url") @db.Text
  loginMessage   String?  @map("login_message") @db.VarChar(280)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById    String?  @map("updated_by") @db.Uuid

  updatedBy User? @relation("BrandingUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@map("branding_settings")
}

/// A generic initiative container. Files and folders may also hang directly off a
/// company with no project (05-domain-model.md), so project_id is nullable there.
model Project {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String        @map("company_id") @db.Uuid
  name        String        @db.VarChar(160)
  code        String?       @db.VarChar(40)
  type        ProjectType   @default(other)
  description String?       @db.Text
  status      ProjectStatus @default(active)
  startDate   DateTime?     @map("start_date") @db.Date
  endDate     DateTime?     @map("end_date") @db.Date
  notes       String?       @db.Text
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById String?       @map("created_by") @db.Uuid

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdBy      User?           @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  folders        Folder[]
  files          File[]
  uploadSessions UploadSession[]
  content        Content[]
  pendingRequests PendingRequest[]

  @@index([companyId, status])
  @@index([companyId, createdAt(sort: Desc)])
  @@index([createdById])
  @@map("projects")
}

/// Visibility follows company membership, never folder ownership: any member of the
/// company sees every folder in it (06-permissions-and-authorization.md).
model Folder {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  projectId      String?  @map("project_id") @db.Uuid
  parentFolderId String?  @map("parent_folder_id") @db.Uuid
  name           String   @db.VarChar(160)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById    String?  @map("created_by") @db.Uuid

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project        Project?        @relation(fields: [projectId], references: [id], onDelete: Restrict)
  parentFolder   Folder?         @relation("FolderTree", fields: [parentFolderId], references: [id], onDelete: Restrict)
  children       Folder[]        @relation("FolderTree")
  createdBy      User?           @relation("FolderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  files          File[]
  uploadSessions UploadSession[]

  @@index([companyId, projectId])
  @@index([companyId, parentFolderId])
  @@index([createdById])
  @@map("folders")
}

model File {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId    String     @map("company_id") @db.Uuid
  projectId    String?    @map("project_id") @db.Uuid
  folderId     String?    @map("folder_id") @db.Uuid
  originalName String     @map("original_name") @db.VarChar(400)
  mimeType     String     @map("mime_type") @db.VarChar(160)
  sizeBytes    BigInt     @map("size_bytes")
  /// {company}/{project|no-project}/{file id}/{original name}. The UUID segment is
  /// what makes the key unguessable (16-security-requirements.md).
  storageKey   String     @unique @map("storage_key") @db.Text
  status       FileStatus @default(received)
  uploadedById String?    @map("uploaded_by") @db.Uuid
  uploadedAt   DateTime   @default(now()) @map("uploaded_at") @db.Timestamptz(6)
  archivedAt   DateTime?  @map("archived_at") @db.Timestamptz(6)
  /// Soft delete: an approved-but-mistaken deletion stays recoverable, and the record
  /// that the file existed is never destroyed (16-security-requirements.md).
  deletedAt    DateTime?  @map("deleted_at") @db.Timestamptz(6)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  company            Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project            Project?  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  folder             Folder?   @relation(fields: [folderId], references: [id], onDelete: Restrict)
  uploadedBy         User?     @relation("FileUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  /// Comments that attached this file as their attachment.
  commentAttachments Comment[] @relation("CommentAttachment")
  relatedContent     Content[] @relation("ContentRelatedFile")

  @@index([companyId, folderId, status])
  @@index([companyId, uploadedAt(sort: Desc)])
  @@index([companyId, projectId])
  @@index([uploadedById])
  @@map("files")
}

/// Control-plane bookkeeping for one in-flight multipart upload. File bytes never
/// pass through this application (07-upload-architecture.md).
model UploadSession {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId           String              @map("company_id") @db.Uuid
  projectId           String?             @map("project_id") @db.Uuid
  folderId            String?             @map("folder_id") @db.Uuid
  initiatedById       String?             @map("initiated_by") @db.Uuid
  storageKey          String              @map("storage_key") @db.Text
  originalName        String              @map("original_name") @db.VarChar(400)
  mimeType            String              @map("mime_type") @db.VarChar(160)
  declaredSizeBytes   BigInt              @map("declared_size_bytes")
  maxAllowedSizeBytes BigInt              @map("max_allowed_size_bytes")
  partSizeBytes       Int                 @map("part_size_bytes")
  /// The storage provider own multipart upload id; every abort and completion needs it.
  providerUploadId    String              @map("provider_upload_id") @db.Text
  status              UploadSessionStatus @default(pending)
  fileId              String?             @unique @map("file_id") @db.Uuid
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// Advanced by part activity; the cleanup job measures inactivity against it.
  lastActivityAt      DateTime            @default(now()) @map("last_activity_at") @db.Timestamptz(6)
  expiresAt           DateTime            @map("expires_at") @db.Timestamptz(6)
  completedAt         DateTime?           @map("completed_at") @db.Timestamptz(6)

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: Restrict)
  folder      Folder?      @relation(fields: [folderId], references: [id], onDelete: Restrict)
  initiatedBy User?        @relation("UploadInitiatedBy", fields: [initiatedById], references: [id], onDelete: Restrict)
  parts       UploadPart[]

  @@index([companyId, status])
  @@index([status, lastActivityAt])
  @@index([initiatedById])
  @@map("upload_sessions")
}

/// A cache of what the browser reported committing. The provider ListParts response is
/// the source of truth and is reconciled against this on resume and at completion.
model UploadPart {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  uploadSessionId String   @map("upload_session_id") @db.Uuid
  partNumber      Int      @map("part_number")
  etag            String   @db.VarChar(120)
  sizeBytes       BigInt   @map("size_bytes")
  uploadedAt      DateTime @default(now()) @map("uploaded_at") @db.Timestamptz(6)

  uploadSession UploadSession @relation(fields: [uploadSessionId], references: [id], onDelete: Cascade)

  @@unique([uploadSessionId, partNumber])
  @@map("upload_parts")
}

/// Removing something you did not create is a request, not an action
/// (06-permissions-and-authorization.md#deletion-request-workflow).
model DeletionRequest {
  id            String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId     String                    @map("company_id") @db.Uuid
  targetType    DeletionRequestTargetType @map("target_type")
  targetId      String                    @map("target_id") @db.Uuid
  requestedById String?                   @map("requested_by") @db.Uuid
  reason        String                    @db.VarChar(1000)
  status        DeletionRequestStatus     @default(pending)
  reviewedById  String?                   @map("reviewed_by") @db.Uuid
  reviewedAt    DateTime?                 @map("reviewed_at") @db.Timestamptz(6)
  reviewNotes   String?                   @map("review_notes") @db.VarChar(1000)
  createdAt     DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)

  company     Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  requestedBy User?   @relation("DeletionRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedBy  User?   @relation("DeletionReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([companyId, status, createdAt(sort: Desc)])
  @@index([targetType, targetId])
  @@index([requestedById])
  @@map("deletion_requests")
}

/// A note attached to whatever it is about, addressed polymorphically. The company is
/// resolved from the target row, never taken from the request.
model Comment {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId        String          @map("company_id") @db.Uuid
  commentableType  CommentableType @map("commentable_type")
  commentableId    String          @map("commentable_id") @db.Uuid
  authorId         String?         @map("author_id") @db.Uuid
  body             String          @db.Text
  attachmentFileId String?         @map("attachment_file_id") @db.Uuid
  deletedAt        DateTime?       @map("deleted_at") @db.Timestamptz(6)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  company    Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  author     User?   @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  attachment File?   @relation("CommentAttachment", fields: [attachmentFileId], references: [id], onDelete: Restrict)

  @@index([commentableType, commentableId, createdAt])
  @@index([companyId, createdAt(sort: Desc)])
  @@index([authorId])
  @@index([attachmentFileId])
  @@map("comments")
}

/// A directed, threaded conversation with one responsible respondent and a lifecycle —
/// unlike a comment, which is informational, and unlike a pending request, which
/// implies a task (03-functional-requirements.md#follow-up-topics).
model Topic {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId         String            @map("company_id") @db.Uuid
  title             String            @db.VarChar(200)
  initialMessage    String            @map("initial_message") @db.Text
  creatorId         String?           @map("creator_id") @db.Uuid
  responsibleUserId String            @map("responsible_user_id") @db.Uuid
  relatedType       TopicRelatedType? @map("related_type")
  relatedId         String?           @map("related_id") @db.Uuid
  priority          Priority          @default(medium)
  dueDate           DateTime?         @map("due_date") @db.Date
  status            TopicStatus       @default(awaiting_response)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  company         Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  creator         User?        @relation("TopicCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  responsibleUser User         @relation("TopicResponsible", fields: [responsibleUserId], references: [id], onDelete: Restrict)
  replies         TopicReply[]

  @@index([companyId, status, createdAt(sort: Desc)])
  @@index([responsibleUserId, status])
  @@index([creatorId, status])
  @@map("topics")
}

model TopicReply {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  topicId   String   @map("topic_id") @db.Uuid
  authorId  String?  @map("author_id") @db.Uuid
  body      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  topic  Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  author User? @relation("TopicReplyAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([topicId, createdAt])
  @@index([authorId])
  @@map("topic_replies")
}

/// One planned piece of content: what it is, when it goes out, who owns it, and where
/// it has got to in production.
model Content {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId         String           @map("company_id") @db.Uuid
  projectId         String?          @map("project_id") @db.Uuid
  title             String           @db.VarChar(200)
  description       String?          @db.Text
  type              ContentType      @default(custom)
  scheduledAt       DateTime         @map("scheduled_at") @db.Timestamptz(6)
  responsibleUserId String?          @map("responsible_user_id") @db.Uuid
  relatedFileId     String?          @map("related_file_id") @db.Uuid
  productionStatus  ProductionStatus @default(planned) @map("production_status")
  priority          Priority         @default(medium)
  notes             String?          @db.Text
  deletedAt         DateTime?        @map("deleted_at") @db.Timestamptz(6)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById       String?          @map("created_by") @db.Uuid

  company         Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project         Project? @relation(fields: [projectId], references: [id], onDelete: Restrict)
  responsibleUser User?    @relation("ContentResponsible", fields: [responsibleUserId], references: [id], onDelete: Restrict)
  publications    Publication[]
  relatedFile     File?    @relation("ContentRelatedFile", fields: [relatedFileId], references: [id], onDelete: Restrict)
  createdBy       User?    @relation("ContentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  /// The calendar's whole reason for existing is range queries over this pair
  /// (14-database-design.md#indexing-strategy).
  @@index([companyId, scheduledAt])
  @@index([companyId, productionStatus])
  @@index([responsibleUserId, scheduledAt])
  @@index([projectId])
  @@index([relatedFileId])
  @@index([createdById])
  @@map("content")
}

/// One thing that happened, addressed to one person. The in-app row is created first
/// and is the system of record; push is a best-effort accelerant on top of it
/// (08-notifications-and-push.md#failure-fallback).
model Notification {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipientId String    @map("recipient_id") @db.Uuid
  /// Null only for platform-level events with no single company. Every event-driven
  /// notification carries one (14-database-design.md).
  companyId   String?   @map("company_id") @db.Uuid
  type        String    @db.VarChar(80)
  title       String    @db.VarChar(200)
  message     String    @db.VarChar(500)
  actorId     String?   @map("actor_id") @db.Uuid
  relatedType String?   @map("related_type") @db.VarChar(40)
  relatedId   String?   @map("related_id") @db.Uuid
  readAt      DateTime? @map("read_at") @db.Timestamptz(6)
  /// When push actually went out for this row. Null means in-app only so far — it is
  /// what the per-user hourly ceiling counts, and what stops one row being pushed twice.
  pushSentAt  DateTime? @map("push_sent_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  recipient User     @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Restrict)
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)
  actor     User?    @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Restrict)

  /// The unread counter and the notification centre are both this query.
  @@index([recipientId, readAt, createdAt(sort: Desc)])
  /// Deduplication looks a row up by exactly this tuple.
  @@index([recipientId, type, relatedType, relatedId])
  @@index([companyId])
  @@index([actorId])
  @@map("notifications")
}

/// In-app delivery is always on — it is the system of record — so a row here only ever
/// turns a channel off (08-notifications-and-push.md#preferences).
model NotificationPreference {
  id        String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  eventType String              @map("event_type") @db.VarChar(80)
  channel   NotificationChannel
  enabled   Boolean             @default(true)
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, eventType, channel])
  @@map("notification_preferences")
}

/// One browser registration. A user can have several; each is disabled or revoked on
/// its own (08-notifications-and-push.md#device-registration-lifecycle).
model PushDevice {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  /// The push service URL the browser handed us. Unique so re-registering the same
  /// browser updates the row instead of accumulating duplicates.
  endpoint   String    @unique @db.Text
  p256dhKey  String    @map("p256dh_key") @db.Text
  authKey    String    @map("auth_key") @db.Text
  userAgent  String?   @map("user_agent") @db.VarChar(400)
  enabled    Boolean   @default(true)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, enabled])
  @@map("push_devices")
}

/// A manual database dump somebody asked for. Global rather than tenant data — a
/// backup is the whole database, so access is gated by role, not by company
/// (14-database-design.md). Phase 1 has no automatic schedule; this row only ever
/// exists because an admin pressed a button (11-backup-and-recovery.md).
model BackupJob {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestedById String?         @map("requested_by") @db.Uuid
  status        BackupJobStatus @default(queued)
  fileName      String?         @map("file_name") @db.VarChar(200)
  fileSizeBytes BigInt?         @map("file_size_bytes")
  /// Where the worker put the file. Never sent to a browser: the download streams
  /// through the API so a path can never become a URL.
  storagePath   String?         @map("storage_path") @db.Text
  errorMessage  String?         @map("error_message") @db.Text
  startedAt     DateTime?       @map("started_at") @db.Timestamptz(6)
  completedAt   DateTime?       @map("completed_at") @db.Timestamptz(6)
  /// The file is deleted at this point whether or not anyone downloaded it.
  expiresAt     DateTime?       @map("expires_at") @db.Timestamptz(6)
  downloadedAt  DateTime?       @map("downloaded_at") @db.Timestamptz(6)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  requestedBy User? @relation("BackupRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)

  @@index([status, createdAt(sort: Desc)])
  @@index([requestedById])
  @@map("backup_jobs")
}

/// One advertising account the agency operates for a client. Phase 1 keeps no
/// credentials and makes no API call: the external id is text the team types, so it is
/// never validated against the platform (09-campaign-management.md).
model AdAccount {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId         String          @map("company_id") @db.Uuid
  platform          AdPlatform
  name              String          @db.VarChar(160)
  externalAccountId String?         @map("external_account_id") @db.VarChar(120)
  status            AdAccountStatus @default(active)
  notes             String?         @db.Text
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById       String?         @map("created_by") @db.Uuid

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdBy User?      @relation("AdAccountCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  campaigns Campaign[]

  @@index([companyId, status])
  @@index([createdById])
  @@map("ad_accounts")
}

/// A campaign as the agency records it. Every money figure here was typed by a person
/// and must be labelled as such wherever it is shown — nothing in Phase 1 reads a live
/// metric (09-campaign-management.md).
model Campaign {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId         String         @map("company_id") @db.Uuid
  adAccountId       String         @map("ad_account_id") @db.Uuid
  /// Denormalised from the account for convenience, and kept in step on write.
  platform          AdPlatform
  name              String         @db.VarChar(200)
  objective         String?        @db.VarChar(160)
  status            CampaignStatus @default(active)
  dailyBudget       Decimal?       @map("daily_budget") @db.Decimal(14, 2)
  totalBudget       Decimal?       @map("total_budget") @db.Decimal(14, 2)
  reportedSpend     Decimal?       @map("reported_spend") @db.Decimal(14, 2)
  reportedBalance   Decimal?       @map("reported_balance") @db.Decimal(14, 2)
  /// The "as of" date someone typed when they last looked at the platform.
  lastCheckedAt     DateTime?      @map("last_checked_at") @db.Timestamptz(6)
  /// The agency decides what a client sees; visible by default (23-open-questions.md).
  visibleToClient   Boolean        @default(true) @map("visible_to_client")
  responsibleUserId String?        @map("responsible_user_id") @db.Uuid
  notes             String?        @db.Text
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById       String?        @map("created_by") @db.Uuid

  company         Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  adAccount       AdAccount         @relation(fields: [adAccountId], references: [id], onDelete: Restrict)
  responsibleUser User?             @relation("CampaignResponsible", fields: [responsibleUserId], references: [id], onDelete: Restrict)
  createdBy       User?             @relation("CampaignCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  history         CampaignHistory[]

  @@index([companyId, status])
  @@index([companyId, visibleToClient])
  @@index([adAccountId])
  @@index([responsibleUserId])
  @@index([createdById])
  @@map("campaigns")
}

/// Append-only: who changed which field, from what to what, and why. This is the main
/// reason the module exists (09-campaign-management.md#change-history).
model CampaignHistory {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaignId String   @map("campaign_id") @db.Uuid
  changedById String? @map("changed_by") @db.Uuid
  fieldName  String   @map("field_name") @db.VarChar(60)
  oldValue   String?  @map("old_value") @db.Text
  newValue   String?  @map("new_value") @db.Text
  note       String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  campaign  Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  changedBy User?    @relation("CampaignHistoryChangedBy", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([campaignId, createdAt(sort: Desc)])
  @@index([changedById])
  @@map("campaign_history")
}

/// A request for something the agency needs from a client or a collaborator: a file,
/// an answer, an approval. Responses are comments on the request, so a reply carrying
/// a file is linked to it by construction (03-functional-requirements.md#pending-requests).
model PendingRequest {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId         String               @map("company_id") @db.Uuid
  projectId         String?              @map("project_id") @db.Uuid
  title             String               @db.VarChar(200)
  description       String               @db.Text
  responsibleUserId String               @map("responsible_user_id") @db.Uuid
  createdById       String?              @map("created_by") @db.Uuid
  /// A date, not an instant: "entregar até quinta" does not have a time zone.
  dueDate           DateTime?            @map("due_date") @db.Date
  priority          Priority             @default(medium)
  status            PendingRequestStatus @default(open)
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  company         Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project         Project? @relation(fields: [projectId], references: [id], onDelete: Restrict)
  responsibleUser User     @relation("PendingRequestResponsible", fields: [responsibleUserId], references: [id], onDelete: Restrict)
  createdBy       User?    @relation("PendingRequestCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([companyId, status, createdAt(sort: Desc)])
  /// "O que estão esperando de mim?" is the query this table exists to answer.
  @@index([responsibleUserId, status])
  @@index([createdById, status])
  @@index([companyId, dueDate])
  @@index([projectId])
  @@map("pending_requests")
}

/// One network's publication record for a content item. Phase 1 is a manual log: the
/// agency records what it posted where, nothing is scheduled or published through an
/// API (03-functional-requirements.md#multi-network-publication-log).
model Publication {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contentId         String             @map("content_id") @db.Uuid
  network           PublicationNetwork
  status            PublicationStatus  @default(planned)
  /// The publication date: when it went out, or when it is meant to go out while the
  /// record is still `planned`/`scheduled`. The spec has one date field, not two.
  publishedAt       DateTime?          @map("published_at") @db.Timestamptz(6)
  link              String?            @db.VarChar(2048)
  responsibleUserId String?            @map("responsible_user_id") @db.Uuid
  notes             String?            @db.Text
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  content         Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  responsibleUser User?   @relation("PublicationResponsible", fields: [responsibleUserId], references: [id], onDelete: Restrict)

  /// One record per network per content item (14-database-design.md).
  @@unique([contentId, network])
  @@index([status, publishedAt])
  @@index([responsibleUserId])
  @@map("publications")
}
