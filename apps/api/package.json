{
  "name": "@agency-hub/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "db:generate": "node scripts/prisma.mjs generate",
    "db:migrate": "node scripts/prisma.mjs migrate dev",
    "db:migrate:deploy": "node scripts/prisma.mjs migrate deploy",
    "db:migrate:down": "node scripts/migrate-down.mjs",
    "db:studio": "node scripts/prisma.mjs studio",
    "postinstall": "prisma generate",
    "db:seed": "tsx src/scripts/seed.ts",
    "start:e2e": "tsx src/index.ts",
    "db:seed:e2e": "tsx src/scripts/seed-e2e.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^10.1.0",
    "@node-rs/argon2": "^2.2.1",
    "@prisma/client": "^6.19.3",
    "dotenv": "^16.6.1",
    "fastify": "^5.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.0",
    "prisma": "^6.19.3",
    "tsx": "^4.16.0",
    "vitest": "^5.0.0"
  }
}
